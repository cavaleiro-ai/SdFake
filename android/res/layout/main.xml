<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textColor="@color/header_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- boas-vindas: aparece ao abrir o app -->
    <ScrollView
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/welcome_title"
                    android:textSize="22sp" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:text="@string/welcome_text" />

                <TextView
                    style="@style/CardTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/follow_title"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/instagram"
                    style="@style/OutlineButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/follow_instagram" />

                <Button
                    android:id="@+id/tiktok"
                    style="@style/OutlineButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/follow_tiktok" />

                <Button
                    android:id="@+id/site"
                    style="@style/OutlineButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/follow_site" />

                <Button
                    android:id="@+id/start"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="22dp"
                    android:text="@string/welcome_start" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. escolher o dispositivo -->
            <LinearLayout
                android:id="@+id/choose"
                style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/choose_title" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="4dp"
                    android:text="@string/choose_text" />

                <LinearLayout
                    android:id="@+id/volumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/none"
                    style="@style/Body"
                    android:layout_marginBottom="8dp"
                    android:text="@string/none_found"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/pick"
                    style="@style/OutlineButton"
                    android:text="@string/pick" />

                <TextView
                    style="@style/Small"
                    android:layout_marginTop="12dp"
                    android:text="@string/picker_help" />
            </LinearLayout>

            <!-- 2. andamento -->
            <LinearLayout
                android:id="@+id/progress"
                style="@style/Card"
                android:visibility="gone">

                <TextView
                    android:id="@+id/target"
                    style="@style/Body" />

                <TextView
                    android:id="@+id/phase"
                    style="@style/CardTitle"
                    android:layout_marginTop="6dp" />

                <ProgressBar
                    android:id="@+id/bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progressTint="@color/blue" />

                <TextView
                    android:id="@+id/detail"
                    style="@style/Body"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/log"
                    style="@style/Small"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Small"
                    android:layout_marginTop="12dp"
                    android:text="@string/running_note" />

                <Button
                    android:id="@+id/cancel"
                    style="@style/OutlineButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/cancel" />
            </LinearLayout>

            <!-- 3. resultado -->
            <LinearLayout
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/result_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/again"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/again" />
            </LinearLayout>

            <!-- como funciona -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/how_title" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="4dp"
                    android:text="@string/how_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
